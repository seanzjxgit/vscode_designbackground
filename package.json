{
  "name": "vscode-desginbackground",
  "displayName": "vscode_desginbackground",
  "description": "Set a local image as the VS Code editor background.",
  "version": "1.0.0",
  "publisher": "your-publisher-id",
  "engines": { "vscode": "^1.85.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/seanzjxgit/vscode_designbackground.git" },
  "main": "./out/extension",
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "keywords": ["wallpaper", "background", "editor", "design"],
  "activationEvents": ["onView:backgroundCover.studio", "onCommand:vscode_desginbackground.open"],
  "contributes": {
    "commands": [
      { "command": "vscode_desginbackground.open", "title": "vscode_desginbackground: Open Settings" },
      { "command": "vscode_desginbackground.selectImage", "title": "vscode_desginbackground: Select Image" },
      { "command": "vscode_desginbackground.clear", "title": "vscode_desginbackground: Clear Background" }
    ],
    "configuration": {
      "title": "Editor Wallpaper",
      "properties": {
        "backgroundCover.imagePath": { "type": "string", "default": "", "description": "Path to the local background image." },
        "backgroundCover.opacity": { "type": "number", "minimum": 0, "maximum": 0.8, "default": 0.2, "description": "Background opacity." },
        "backgroundCover.blur": { "type": "number", "minimum": 0, "maximum": 100, "default": 0, "description": "Background blur in pixels." },
        "backgroundCover.sizeModel": { "type": "string", "enum": ["cover", "contain", "repeat", "center"], "default": "cover", "description": "How the image is fitted to the editor." },
        "backgroundCover.blendModel": { "type": "string", "enum": ["auto", "multiply", "lighten"], "default": "auto", "description": "How the wallpaper blends with the editor." }
      }
    },
    "viewsContainers": { "activitybar": [{ "id": "backgroundCover-explorer", "title": "Wallpaper", "icon": "resources/big.svg" }] },
    "views": { "backgroundCover-explorer": [{ "id": "backgroundCover.studio", "type": "webview", "name": "Wallpaper" }] }
  },
  "scripts": { "vscode:prepublish": "npm run build:webview && npm run compile", "vscode:uninstall": "node ./out/uninstall", "compile": "tsc -p ./", "watch": "tsc -watch -p ./", "package": "vsce package", "build:webview": "cd webview && npm run build", "test": "npm run compile", "check": "tslint -p ./" },
  "devDependencies": { "@types/fs-extra": "^11.0.4", "@types/lockfile": "^1.0.4", "@types/node": "^22.9.0", "@types/vscode": "^1.85.0", "@vscode/vsce": "^3.9.2", "typescript": "^4.5.4" },
  "dependencies": { "async-mutex": "^0.5.0", "fs-extra": "^11.2.0", "proper-lockfile": "^4.1.2", "@vscode/sudo-prompt": "^9.3.2" }
}
